# Copie para ".env" e ajuste para o seu ambiente (nao versionar .env)

# Montagem / discos
BACKUP_DESTINO_BASE=/media/usbdiario
# UUID unico (opcional)
# BACKUP_UUID_HD_EXTERNO=98EC8C32EC8C0D26
# Multi-HD: pode ser JSON (recomendado para alias) ou lista separada por virgula
BACKUP_UUIDS_HD_EXTERNOS_JSON=[{"uuid":"98EC8C32EC8C0D26","alias":"HD-USB-1"},{"uuid":"1111222233334444","alias":"HD-USB-2"}]
# BACKUP_UUIDS_HD_EXTERNOS=98EC8C32EC8C0D26,1111222233334444

# Agendamento (ms)
BACKUP_CHECK_INTERVAL_MS=3600000

# Logs / estado
BACKUP_LOG_DIR=/dados/logs/
# BACKUP_ESTADO_PATH=/dados/logs/backup_estado.json

# Backup dados
BACKUP_DADOS_ATIVO=true
BACKUP_DADOS_ORIGEM=/dados/backup/bacula/
# Por default vira $BACKUP_DESTINO_BASE/bacula
# BACKUP_DADOS_DESTINO=/media/usbdiario/bacula

# Backup VMs
BACKUP_VMS_ATIVO=true
BACKUP_VMS_ORIGEM=/mnt/dados/dump
# Por default vira $BACKUP_DESTINO_BASE/vms
# BACKUP_VMS_DESTINO=/media/usbdiario/vms
# Extensoes permitidas (opcional): lista separada por virgula. Ex.: .vma.zst
# BACKUP_VMS_EXTENSOES=.vma.zst

# Retencao VMs
BACKUP_VMS_RETENCAO_DIAS=90
BACKUP_VMS_RETENCAO_ESPACO_MINIMO_GB=10
BACKUP_VMS_RETENCAO_EXCLUIR_ANTIGOS=true

