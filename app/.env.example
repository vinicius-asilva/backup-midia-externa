# Backup de dados
BACKUP_DADOS_ORIGEM=/dados/backup/bacula/
BACKUP_DADOS_DESTINO=/media/usbdiario/bacula
BACKUP_DADOS_NOME=Backup Dados
BACKUP_DADOS_DESCRICAO=Backup arquivo bacula
BACKUP_DADOS_VERIFICAR_HASH=false
BACKUP_DADOS_ATIVO=true

# Backup de VMs
BACKUP_VMS_ORIGEM=/mnt/dados/dump
BACKUP_VMS_DESTINO=/media/usbdiario/vms
BACKUP_VMS_NOME=Backup VMS
BACKUP_VMS_DESCRICAO=Backup de máquinas virtuais
BACKUP_VMS_EXTENSOES=.zst
BACKUP_VMS_VERIFICAR_HASH=false
BACKUP_VMS_ATIVO=true
BACKUP_VMS_RETENCAO_DIAS=90
BACKUP_VMS_RETENCAO_ESPACO_MINIMO_GB=10
BACKUP_VMS_RETENCAO_EXCLUIR_ANTIGOS=true
BACKUP_VMS_RETENCAO_MODO_DRY_RUN=false

# Discos externos (UUIDs)
# Use BACKUP_UUIDS_HD_EXTERNOS para lista simples ou BACKUP_UUIDS_HD_EXTERNOS_JSON para objetos com alias/retencao
BACKUP_UUIDS_HD_EXTERNOS=uuid-hd-1,uuid-hd-2
# BACKUP_UUIDS_HD_EXTERNOS_JSON=[{"uuid":"uuid-hd-1","alias":"HD-1"},{"uuid":"uuid-hd-2","alias":"HD-2"}]

# Agendamento
BACKUP_CHECK_INTERVAL_MS=3600000
BACKUP_SCHEDULE_DIAS=segunda,terca,quarta,quinta,sexta
BACKUP_SCHEDULE_INICIO=07:00
BACKUP_SCHEDULE_FIM=18:00

# Zabbix
ZABBIX_SERVER=192.168.0.202
ZABBIX_HOST=pve

# Modo de teste geral
BACKUP_DRY_RUN=false
